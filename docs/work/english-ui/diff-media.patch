diff --git a/lib/services/translate/translator.dart b/lib/services/translate/translator.dart
new file mode 100644
index 000000000..695784ad9
--- /dev/null
+++ b/lib/services/translate/translator.dart
@@ -0,0 +1,323 @@
+import 'dart:collection';
+import 'dart:io' show Platform;
+
+import 'package:PiliPlus/utils/storage.dart';
+import 'package:PiliPlus/utils/storage_pref.dart';
+import 'package:dio/dio.dart';
+import 'package:flutter/foundation.dart' show debugPrint, kDebugMode;
+import 'package:google_mlkit_translation/google_mlkit_translation.dart';
+
+/// Subtitle translation service. The index is stored in
+/// `SettingBoxKey.translateService`.
+enum TranslateService {
+  offline('離線模型'),
+  deepl('DeepL'),
+  google('Google Cloud');
+
+  const TranslateService(this.label);
+  final String label;
+}
+
+enum ModelStatus { unsupported, notDownloaded, downloaded }
+
+/// Result of [Translator.ensureModel].
+typedef ModelResult = ({bool ok, String? error});
+
+/// Chinese to English translation: on-device ML Kit (Android only), plus
+/// DeepL / Google Cloud Translation for subtitles.
+///
+/// Every failure returns the original text, so callers can always display
+/// the result.
+abstract final class Translator {
+  /// English UI mode (`Pref.appLanguage == 3`).
+  static bool get isEnglishMode => Pref.appLanguage == 3;
+
+  static bool get offlineSupported => Platform.isAndroid;
+
+  /// Danmaku are translated with the offline model only.
+  static bool get danmakuEnabled =>
+      isEnglishMode && Pref.translateDanmaku && offlineSupported;
+
+  static TranslateService get service {
+    final i = Pref.translateService;
+    return TranslateService.values[i >= 0 && i < 3 ? i : 0];
+  }
+
+  static const _deeplKey = 'deepl';
+  static const _googleKey = 'google';
+
+  static String get deeplApiKey =>
+      GStorage.translateSecrets.get(_deeplKey)?.trim() ?? '';
+  static String get googleApiKey =>
+      GStorage.translateSecrets.get(_googleKey)?.trim() ?? '';
+
+  static Future<void> setApiKey(TranslateService service, String key) {
+    final k = switch (service) {
+      TranslateService.deepl => _deeplKey,
+      TranslateService.google => _googleKey,
+      TranslateService.offline => null,
+    };
+    if (k == null) return Future.value();
+    key = key.trim();
+    return key.isEmpty
+        ? GStorage.translateSecrets.delete(k)
+        : GStorage.translateSecrets.put(k, key);
+  }
+
+  /// A key is present for the selected online service.
+  static bool get onlineConfigured => switch (service) {
+    TranslateService.deepl => deeplApiKey.isNotEmpty,
+    TranslateService.google => googleApiKey.isNotEmpty,
+    TranslateService.offline => false,
+  };
+
+  static const modelUnavailableMessage =
+      '離線模型無法使用，可在 播放 › 字幕 › 翻譯服務 填入 DeepL 或 Google Cloud 金鑰';
+
+  static final _cjk = RegExp(r'[㐀-鿿]');
+
+  static bool needsTranslation(String text) => _cjk.hasMatch(text);
+
+  // ---- LRU cache (key: original text) ----
+
+  static const _cacheLimit = 5000;
+  static final LinkedHashMap<String, String> _cache = LinkedHashMap();
+
+  /// Cached translation, or null.
+  static String? cached(String text) {
+    final v = _cache.remove(text);
+    if (v != null) _cache[text] = v;
+    return v;
+  }
+
+  static void _put(String text, String translated) {
+    _cache.remove(text);
+    _cache[text] = translated;
+    if (_cache.length > _cacheLimit) {
+      _cache.remove(_cache.keys.first);
+    }
+  }
+
+  // ---- Public API ----
+
+  /// Translates [texts]; items that fail (or do not need translation) are
+  /// returned unchanged. With [online] and a configured key the online
+  /// service is used first, then the offline model.
+  static Future<List<String>> translateBatch(
+    List<String> texts, {
+    bool online = false,
+  }) async {
+    final result = List<String>.of(texts);
+    final todo = <String>{};
+    for (var i = 0; i < texts.length; i++) {
+      final t = texts[i];
+      if (!needsTranslation(t)) continue;
+      final c = cached(t);
+      if (c != null) {
+        result[i] = c;
+      } else {
+        todo.add(t);
+      }
+    }
+    if (todo.isEmpty) return result;
+
+    final done = <String, String>{};
+    var remaining = todo.toList();
+
+    if (online && onlineConfigured) {
+      remaining = await _translateOnline(remaining, done);
+    }
+    if (remaining.isNotEmpty) {
+      await _translateOffline(remaining, done);
+    }
+
+    done.forEach(_put);
+    for (var i = 0; i < texts.length; i++) {
+      if (done[texts[i]] case final v?) result[i] = v;
+    }
+    return result;
+  }
+
+  // ---- Online ----
+
+  static Dio? _dio;
+  // Own Dio: no bilibili base url, cookies or account interceptors.
+  static Dio get _client => _dio ??= Dio(
+    BaseOptions(
+      connectTimeout: const Duration(seconds: 10),
+      receiveTimeout: const Duration(seconds: 30),
+    ),
+  );
+
+  /// Returns the texts that failed.
+  static Future<List<String>> _translateOnline(
+    List<String> texts,
+    Map<String, String> out,
+  ) async {
+    final failed = <String>[];
+    final isDeepl = service == TranslateService.deepl;
+    final size = isDeepl ? 50 : 128;
+    for (var i = 0; i < texts.length; i += size) {
+      final end = i + size > texts.length ? texts.length : i + size;
+      final chunk = texts.sublist(i, end);
+      try {
+        final res = isDeepl ? await _deepl(chunk) : await _google(chunk);
+        if (res.length != chunk.length) throw StateError('length mismatch');
+        for (var j = 0; j < chunk.length; j++) {
+          if (res[j].isNotEmpty) {
+            out[chunk[j]] = res[j];
+          } else {
+            failed.add(chunk[j]);
+          }
+        }
+      } catch (e) {
+        if (kDebugMode) debugPrint('online translate failed: $e');
+        failed.addAll(chunk);
+      }
+    }
+    return failed;
+  }
+
+  static Future<List<String>> _deepl(List<String> chunk) async {
+    final key = deeplApiKey;
+    final host = key.endsWith(':fx') ? 'api-free.deepl.com' : 'api.deepl.com';
+    final res = await _client.post(
+      'https://$host/v2/translate',
+      data: {
+        'text': chunk,
+        'source_lang': 'ZH',
+        'target_lang': 'EN-US',
+      },
+      options: Options(headers: {'Authorization': 'DeepL-Auth-Key $key'}),
+    );
+    return (res.data['translations'] as List)
+        .map((e) => e['text'] as String)
+        .toList();
+  }
+
+  static Future<List<String>> _google(List<String> chunk) async {
+    final res = await _client.post(
+      'https://translation.googleapis.com/language/translate/v2',
+      queryParameters: {'key': googleApiKey},
+      data: {'q': chunk, 'source': 'zh', 'target': 'en', 'format': 'text'},
+    );
+    return (res.data['data']['translations'] as List)
+        .map((e) => _unescapeHtml(e['translatedText'] as String))
+        .toList();
+  }
+
+  static String _unescapeHtml(String s) => s
+      .replaceAll('&#39;', "'")
+      .replaceAll('&quot;', '"')
+      .replaceAll('&lt;', '<')
+      .replaceAll('&gt;', '>')
+      .replaceAll('&amp;', '&');
+
+  // ---- Offline (ML Kit, Android only) ----
+
+  static const _zh = 'zh';
+  static const _en = 'en';
+
+  static OnDeviceTranslatorModelManager? _manager;
+  static OnDeviceTranslatorModelManager get _modelManager =>
+      _manager ??= OnDeviceTranslatorModelManager();
+  static OnDeviceTranslator? _translator;
+
+  static bool _modelReady = false;
+  static DateTime? _lastCheck;
+
+  /// Last error from [ensureModel], for display.
+  static String? lastModelError;
+
+  /// Whether the offline model is usable now. A negative answer is cached
+  /// for 30 seconds so repeated callers do not hammer the platform channel.
+  static Future<bool> isOfflineReady() async {
+    if (!offlineSupported) return false;
+    if (_modelReady) return true;
+    final last = _lastCheck;
+    if (last != null &&
+        DateTime.now().difference(last) < const Duration(seconds: 30)) {
+      return false;
+    }
+    _lastCheck = DateTime.now();
+    try {
+      _modelReady = await _modelManager.isModelDownloaded(_zh);
+    } catch (_) {
+      _modelReady = false;
+    }
+    return _modelReady;
+  }
+
+  static Future<void> _translateOffline(
+    List<String> texts,
+    Map<String, String> out,
+  ) async {
+    if (!await isOfflineReady()) return;
+    final t = _translator ??= OnDeviceTranslator(
+      sourceLanguage: TranslateLanguage.chinese,
+      targetLanguage: TranslateLanguage.english,
+    );
+    for (final text in texts) {
+      try {
+        final r = (await t.translateText(text)).trim();
+        if (r.isNotEmpty) out[text] = r;
+      } catch (e) {
+        if (kDebugMode) debugPrint('offline translate failed: $e');
+      }
+    }
+  }
+
+  static Future<ModelStatus> modelStatus() async {
+    if (!offlineSupported) return ModelStatus.unsupported;
+    try {
+      final ok = await _modelManager.isModelDownloaded(_zh);
+      _modelReady = ok;
+      return ok ? ModelStatus.downloaded : ModelStatus.notDownloaded;
+    } catch (_) {
+      return ModelStatus.notDownloaded;
+    }
+  }
+
+  /// Downloads the zh and en models when missing. The plugin reports no
+  /// progress, so callers only get the final result. This is also the entry
+  /// point to call when the user switches to English.
+  static Future<ModelResult> ensureModel() async {
+    if (!offlineSupported) {
+      return (ok: false, error: '此平台不支援離線翻譯');
+    }
+    try {
+      final zh = await _modelManager.downloadModel(
+        _zh,
+        isWifiRequired: false,
+      );
+      final en = await _modelManager.downloadModel(
+        _en,
+        isWifiRequired: false,
+      );
+      if (zh && en) {
+        _modelReady = true;
+        lastModelError = null;
+        return (ok: true, error: null);
+      }
+    } catch (e) {
+      if (kDebugMode) debugPrint('model download failed: $e');
+    }
+    _modelReady = false;
+    _lastCheck = DateTime.now();
+    lastModelError = modelUnavailableMessage;
+    return (ok: false, error: modelUnavailableMessage);
+  }
+
+  static Future<bool> deleteModel() async {
+    if (!offlineSupported) return false;
+    try {
+      await _translator?.close();
+      _translator = null;
+      final ok = await _modelManager.deleteModel(_zh);
+      if (ok) _modelReady = false;
+      return ok;
+    } catch (_) {
+      return false;
+    }
+  }
+}
diff --git a/lib/services/translate/translate_queue.dart b/lib/services/translate/translate_queue.dart
new file mode 100644
index 000000000..4ec634614
--- /dev/null
+++ b/lib/services/translate/translate_queue.dart
@@ -0,0 +1,88 @@
+import 'dart:collection';
+
+import 'package:PiliPlus/services/translate/translator.dart';
+
+/// Background (offline) translation queue for danmaku. Results land in the
+/// [Translator] cache; callers read them with [Translator.cached] and never
+/// wait.
+class TranslateQueue {
+  TranslateQueue({this.maxPending, this.batchSize = 12, this.positionMs});
+
+  /// Max pending texts; the oldest are dropped first. Null for unlimited.
+  final int? maxPending;
+  final int batchSize;
+
+  /// Current playback position. When set, the nearest upcoming texts are
+  /// translated first (those within the next 30 s come first naturally),
+  /// then later ones, then already-played ones. When null the queue is FIFO.
+  final int Function()? positionMs;
+
+  /// text -> time in ms (insertion ordered).
+  final LinkedHashMap<String, int> _jobs = LinkedHashMap();
+  bool _running = false;
+  bool _disposed = false;
+
+  int get length => _jobs.length;
+
+  void add(String text, [int timeMs = 0]) {
+    if (_disposed ||
+        !Translator.needsTranslation(text) ||
+        Translator.cached(text) != null) {
+      return;
+    }
+    final old = _jobs[text];
+    if (old != null) {
+      if (timeMs < old) _jobs[text] = timeMs;
+      return;
+    }
+    _jobs[text] = timeMs;
+    final cap = maxPending;
+    if (cap != null) {
+      while (_jobs.length > cap) {
+        _jobs.remove(_jobs.keys.first);
+      }
+    }
+    _run();
+  }
+
+  List<String> _takeBatch() {
+    final List<String> batch;
+    final pos = positionMs;
+    if (pos == null) {
+      batch = _jobs.keys.take(batchSize).toList();
+    } else {
+      final now = pos();
+      int score(int t) => t >= now ? t - now : (1 << 40) + (now - t);
+      final entries = _jobs.entries.toList()
+        ..sort((a, b) => score(a.value).compareTo(score(b.value)));
+      batch = entries.take(batchSize).map((e) => e.key).toList();
+    }
+    batch.forEach(_jobs.remove);
+    return batch;
+  }
+
+  Future<void> _run() async {
+    if (_running) return;
+    _running = true;
+    try {
+      while (!_disposed && _jobs.isNotEmpty) {
+        if (!await Translator.isOfflineReady()) {
+          _jobs.clear();
+          break;
+        }
+        if (_disposed) break;
+        final batch = _takeBatch();
+        try {
+          await Translator.translateBatch(batch);
+        } catch (_) {}
+      }
+    } finally {
+      _running = false;
+    }
+  }
+
+  void dispose() {
+    _disposed = true;
+    _jobs.clear();
+  }
+}
diff --git a/lib/pages/setting/widgets/translate_dialogs.dart b/lib/pages/setting/widgets/translate_dialogs.dart
new file mode 100644
index 000000000..f843483fd
--- /dev/null
+++ b/lib/pages/setting/widgets/translate_dialogs.dart
@@ -0,0 +1,167 @@
+import 'package:PiliPlus/common/widgets/zh_material.dart';
+import 'package:PiliPlus/services/translate/translator.dart';
+import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
+
+/// Masks a key for display, keeping the last 4 characters.
+String maskApiKey(String key) {
+  if (key.isEmpty) return '未設定';
+  final tail = key.length > 4 ? key.substring(key.length - 4) : '';
+  return '已設定 ••••$tail';
+}
+
+/// Edit an API key. The field is obscured; an empty value clears the key.
+Future<bool> showApiKeyDialog(
+  BuildContext context,
+  TranslateService service,
+) async {
+  final current = service == TranslateService.deepl
+      ? Translator.deeplApiKey
+      : Translator.googleApiKey;
+  final controller = TextEditingController(text: current);
+  final res = await showDialog<bool>(
+    context: context,
+    builder: (context) => AlertDialog(
+      title: Text('${service.label} 金鑰'),
+      content: TextField(
+        controller: controller,
+        autofocus: true,
+        obscureText: true,
+        enableSuggestions: false,
+        autocorrect: false,
+        decoration: InputDecoration(
+          hintText: service == TranslateService.deepl
+              ? '貼上 DeepL API 金鑰（免費版以 :fx 結尾）'
+              : '貼上 Google Cloud Translation API 金鑰',
+          helperText: '金鑰只存在本機，不會被匯出設定',
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: Navigator.of(context).pop,
+          child: Text(
+            '取消',
+            style: TextStyle(color: Theme.of(context).colorScheme.outline),
+          ),
+        ),
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(true),
+          child: const Text('確定'),
+        ),
+      ],
+    ),
+  );
+  final text = controller.text;
+  controller.dispose();
+  if (res == true) {
+    await Translator.setApiKey(service, text);
+    return true;
+  }
+  return false;
+}
+
+/// Offline model: shows the status, with download and delete actions.
+Future<void> showTranslateModelDialog(BuildContext context) {
+  return showDialog<void>(
+    context: context,
+    builder: (context) => const _ModelDialog(),
+  );
+}
+
+class _ModelDialog extends StatefulWidget {
+  const _ModelDialog();
+
+  @override
+  State<_ModelDialog> createState() => _ModelDialogState();
+}
+
+class _ModelDialogState extends State<_ModelDialog> {
+  ModelStatus? _status;
+  bool _busy = false;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _refresh();
+  }
+
+  Future<void> _refresh() async {
+    final s = await Translator.modelStatus();
+    if (mounted) setState(() => _status = s);
+  }
+
+  Future<void> _download() async {
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    final res = await Translator.ensureModel();
+    final s = await Translator.modelStatus();
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _status = s;
+      _error = res.ok ? null : res.error;
+    });
+  }
+
+  Future<void> _delete() async {
+    setState(() => _busy = true);
+    final ok = await Translator.deleteModel();
+    final s = await Translator.modelStatus();
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _status = s;
+    });
+    if (!ok) SmartDialog.showToast('刪除失敗');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final status = _status;
+    final text = switch (status) {
+      null => '檢查中…',
+      ModelStatus.unsupported => '此平台不支援離線翻譯',
+      ModelStatus.notDownloaded => '尚未下載',
+      ModelStatus.downloaded => '已下載（中文 → 英文）',
+    };
+    return AlertDialog(
+      title: const Text('離線翻譯模型'),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(text),
+          if (_busy) ...[
+            const SizedBox(height: 12),
+            const LinearProgressIndicator(),
+          ],
+          if (_error != null) ...[
+            const SizedBox(height: 12),
+            Text(
+              _error!,
+              style: TextStyle(color: Theme.of(context).colorScheme.error),
+            ),
+          ],
+        ],
+      ),
+      actions: [
+        if (status == ModelStatus.downloaded)
+          TextButton(
+            onPressed: _busy ? null : _delete,
+            child: const Text('刪除'),
+          ),
+        if (status == ModelStatus.notDownloaded)
+          TextButton(
+            onPressed: _busy ? null : _download,
+            child: const Text('下載'),
+          ),
+        TextButton(
+          onPressed: Navigator.of(context).pop,
+          child: const Text('關閉'),
+        ),
+      ],
+    );
+  }
+}
