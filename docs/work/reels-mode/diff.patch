+
+/// 豎屏模式（類似 IG Reels）：直向 PageView，上下滑換影片。
+///
+/// [embedded] 為 true 時是首頁分頁：不顯示返回鍵，並且只有在分頁停在豎屏、
+/// 首頁在最上層、App 在前景時才載入與播放。否則是路由 `/reels`
+/// （參數 `{aid, bvid, cid, title, cover, progress}`）。
+class ReelsPage extends StatefulWidget {
+  const ReelsPage({super.key, this.embedded = false});
+
+  final bool embedded;
+
+  @override
+  State<ReelsPage> createState() => _ReelsPageState();
+}
+
+class _ReelsPageState extends State<ReelsPage>
+    with WidgetsBindingObserver, AutomaticKeepAliveClientMixin {
+  ReelsController? _ctr;
+  late final String _tag = 'reels_${identityHashCode(this)}';
+
+  bool _resumed = true;
+  bool _tickerOn = true;
+  bool _visible = false;
+
+  final _danmakuOn = Pref.enableShowDanmaku.obs;
+
+  HomeController? _home;
+  MainController? _main;
+  Worker? _mainWorker;
+
+  @override
+  bool get wantKeepAlive => widget.embedded;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    if (widget.embedded) {
+      if (Get.isRegistered<HomeController>()) {
+        _home = Get.find<HomeController>()
+          ..tabController.addListener(_evaluate);
+      }
+      if (Get.isRegistered<MainController>()) {
+        _main = Get.find<MainController>();
+        _mainWorker = ever(_main!.selectedIndex, (_) => _evaluate());
+      }
+    } else {
+      _create();
+    }
+  }
+
+  void _create() {
+    final seed = widget.embedded ? null : Get.arguments;
+    _ctr = Get.put(
+      ReelsController(seed: seed is Map ? seed : null),
+      tag: _tag,
+    );
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    // 其他頁面蓋在上面時，TickerMode 會關閉
+    _tickerOn = TickerMode.valuesOf(context).enabled;
+    _scheduleEvaluate();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    _resumed = state == AppLifecycleState.resumed;
+    _evaluate();
+  }
+
+  void _scheduleEvaluate() {
+    // 不在 build 期間改變狀態
+    scheduleMicrotask(() {
+      if (mounted) _evaluate();
+    });
+  }
+
+  bool get _tabVisible {
+    if (!widget.embedded) return true;
+    final home = _home;
+    if (home == null) return false;
+    final index = home.tabs.indexOf(HomeTabType.reels);
+    final tc = home.tabController;
+    if (index < 0 || tc.index != index || tc.indexIsChanging) return false;
+    final main = _main;
+    if (main != null) {
+      final i = main.selectedIndex.value;
+      if (i < 0 ||
+          i >= main.navigationBars.length ||
+          main.navigationBars[i] != NavigationBarType.home) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void _evaluate() {
+    if (!mounted) return;
+    final visible = _resumed && _tickerOn && _tabVisible;
+    if (visible == _visible) return;
+    _visible = visible;
+    if (visible && _ctr == null) {
+      setState(_create);
+    }
+    _ctr?.setActive(visible);
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _home?.tabController.removeListener(_evaluate);
+    _mainWorker?.dispose();
+    if (_ctr != null) Get.delete<ReelsController>(tag: _tag);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    super.build(context);
+    final ctr = _ctr;
+    Widget child;
+    if (ctr == null) {
+      child = const ColoredBox(color: Colors.black);
+    } else {
+      child = _ReelsBody(
+        ctr: ctr,
+        embedded: widget.embedded,
+        danmakuOn: _danmakuOn,
+      );
+    }
+    if (widget.embedded) {
+      // 垂直滑動不要觸發首頁上下列的自動隱藏
+      child = NotificationListener<ScrollNotification>(
+        onNotification: (_) => true,
+        child: child,
+      );
+    }
+    return child;
+  }
