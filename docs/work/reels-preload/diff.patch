+/// 一個播放器槽位（目前播放或預載）。
+class _Slot {
+  _Slot(this.player, this.video);
+
+  final Player player;
+  final VideoController video;
+  final List<StreamSubscription> subs = [];
+
+  /// 這個槽位載入（或載入中）的影片
+  int? aid;
+  String? media;
+
+  /// 已開啟完成
+  bool opened = false;
+
+  /// 來源來自 `player_preload`（失敗時要改用 videoUrl 重試）
+  bool fromPreload = false;
+
+  /// 預載開啟中的 Future（不會丟例外）
+  Future<void>? opening;
+
+  /// 槽位被重新指派時加一，讓過時的非同步開啟丟棄
+  int token = 0;
+
+  void reset() {
+    token++;
+    aid = null;
+    media = null;
+    opened = false;
+    fromPreload = false;
+    opening = null;
+  }
+
+  void dispose() {
+    token++;
+    for (final sub in subs) {
+      sub.cancel();
+    }
+    subs.clear();
+    player.dispose();
+  }
+}
